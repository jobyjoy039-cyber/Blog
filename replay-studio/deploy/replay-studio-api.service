[Unit]
Description=Replay Studio dashboard/API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=replaystudio
Group=replaystudio
WorkingDirectory=/opt/replay-studio
Environment=REPLAY_STUDIO_CONFIG=/etc/replay-studio/config.toml
ExecStart=/opt/replay-studio/.venv/bin/replay-studio api
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/replay-studio
UMask=0077

[Install]
WantedBy=multi-user.target
