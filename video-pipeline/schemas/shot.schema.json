{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "shots.json — output of Storyboard Director",
  "type": "object",
  "required": ["shots"],
  "properties": {
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "shot_id", "scene_id", "camera_zoom", "avatar_visible",
          "b_roll_needed", "graphics_needed", "transition_in", "transition_out",
          "color_grade"
        ],
        "properties": {
          "shot_id": { "type": "string", "pattern": "^shot-\\d{3,}$" },
          "scene_id": { "type": "string", "pattern": "^scene-\\d{3,}$" },
          "camera_zoom": { "type": "string", "enum": ["wide", "medium", "medium-close", "close-up"] },
          "avatar_visible": { "type": "boolean" },
          "background_change": { "type": "boolean", "default": false },
          "b_roll_needed": { "type": "boolean" },
          "graphics_needed": {
            "type": "array",
            "items": { "type": "string", "enum": ["lower-third", "animated-title", "chart", "callout", "none"] }
          },
          "transition_in": { "type": "string", "enum": ["cut", "crossfade", "wipe", "zoom", "slide"] },
          "transition_out": { "type": "string", "enum": ["cut", "crossfade", "wipe", "zoom", "slide"] },
          "color_grade": { "type": "string" }
        }
      }
    }
  }
}
